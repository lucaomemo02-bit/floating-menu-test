<?xml version="1.0" encoding="utf-8"?>
<!-- Painel expandido: cabeçalho arrastável + controles de teste com rolagem -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- Cabeçalho: alça de arraste + botão de recolher -->
    <LinearLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3B82F6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/panel_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_collapse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/collapse_symbol"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Caixa de seleção -->
            <CheckBox
                android:id="@+id/cb_outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_outline" />

            <!-- Botão de alternância -->
            <Switch
                android:id="@+id/sw_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/opt_compact" />

            <!-- Seletor de opções: radio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lbl_size"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/size_small" />

                <RadioButton
                    android:id="@+id/rb_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/size_medium" />

                <RadioButton
                    android:id="@+id/rb_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/size_large" />
            </RadioGroup>

            <!-- Seletor de opções: spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lbl_accent"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_accent"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Controle deslizante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lbl_opacity"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sb_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="70"
                android:minHeight="32dp"
                android:progress="70" />

            <!-- Botões -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_reset"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_clear"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Log de eventos: confirma que cada toque chegou ao controle certo -->
            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1F2937"
                android:fontFamily="monospace"
                android:minLines="5"
                android:padding="8dp"
                android:textColor="#A7F3D0"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
